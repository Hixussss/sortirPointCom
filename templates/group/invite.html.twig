{% extends 'base.html.twig' %}

{% block title %}{{ 'Invite User to Group'|trans }}{% endblock %}

{% block body %}
<section class="py-12 mt-8">
    <div class="container mx-auto max-w-4xl">
        <div class="bg-white shadow-lg rounded-lg p-8">
            <h1 class="text-2xl font-bold text-gray-800 mb-6">{{ 'Invite a User to Group'|trans }}</h1>
            
            {{ form_start(inviteForm, { 'attr': { 'class': 'space-y-6' } }) }}
                {{ form_row(inviteForm.usernameOrEmail, {
                    'label': 'Enter email or username to invite',
                    'attr': { 'class': 'p-3 border border-gray-300 rounded-lg w-full' }
                }) }}
                
                <button type="submit" class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-all">
                    {{ 'Send Invitation'|trans }}
                </button>
            {{ form_end(inviteForm) }}
        </div>
    </div>
</section>
{% endblock %}
