{% extends 'base.html.twig' %}
{% block title %}{{ 'user_registration_title'|trans }}{% endblock %}

{% block body %}
<div class="max-w-lg mx-auto mt-20 bg-white shadow-md rounded-lg p-8">
    <h1 class="text-2xl font-bold text-gray-800 mb-6">{{ 'register_new_user'|trans }}</h1>

    {{ form_start(form, {'action': path('app_register'), 'method': 'POST'}) }}
    {{ form_errors(form) }}

        <div class="mb-4">
            {{ form_label(form.username, 'form.username'|trans, {'label_attr': {'class': 'block text-gray-700 font-medium mb-2'}}) }}
            {{ form_widget(form.username, {'attr': {'class': 'w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500'}}) }}
            {{ form_errors(form.username) }}
        </div>
        <div class="mb-4">
            {{ form_label(form.email, 'form.email'|trans, {'label_attr': {'class': 'block text-gray-700 font-medium mb-2'}}) }}
            {{ form_widget(form.email, {'attr': {'class': 'w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500'}}) }}
            {{ form_errors(form.email) }}
        </div>
        <div class="mb-4">
            {{ form_label(form.firstName, 'form.first_name'|trans, {'label_attr': {'class': 'block text-gray-700 font-medium mb-2'}}) }}
            {{ form_widget(form.firstName, {'attr': {'class': 'w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500'}}) }}
            {{ form_errors(form.firstName) }}
        </div>
        <div class="mb-4">
            {{ form_label(form.lastName, 'form.last_name'|trans, {'label_attr': {'class': 'block text-gray-700 font-medium mb-2'}}) }}
            {{ form_widget(form.lastName, {'attr': {'class': 'w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500'}}) }}
            {{ form_errors(form.lastName) }}
        </div>
        <div class="mb-4">
            {{ form_label(form.password, 'form.password'|trans, {'label_attr': {'class': 'block text-gray-700 font-medium mb-2'}}) }}
            {{ form_widget(form.password, {'attr': {'class': 'w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500'}}) }}
            {{ form_errors(form.password) }}
        </div>
        <div class="mb-4">
            {{ form_label(form.site, 'form.site'|trans, {'label_attr': {'class': 'block text-gray-700 font-medium mb-2'}}) }}
            {{ form_widget(form.site, {'attr': {'class': 'w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500'}}) }}
            {{ form_errors(form.site) }}
        </div>
        {{ form_widget(form.submit, {'attr': {'class': 'bg-blue-500 text-white font-bold py-2 px-4 rounded hover:bg-blue-600'}}) }}
    {{ form_end(form) }}
</div>
{% endblock %}
