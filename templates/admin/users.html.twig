{% extends 'base.html.twig' %}
{% block title %}{{ 'admin_manage_users_title'|trans }}{% endblock %}

{% block body %}
<section class="py-20 mt-8">
    <div class="container mx-auto">
        <!-- Back to Dashboard Button -->
        <div class="mb-6">
            <a href="{{ path('admin_dashboard') }}"
               class="inline-flex items-center px-4 py-2 bg-gray-200 text-gray-800 text-sm font-semibold rounded-lg hover:bg-gray-300 transition-all">
                <i class="uil uil-arrow-left mr-2"></i> {{ 'back_to_dashboard'|trans }}
            </a>
        </div>

        <h1 class="text-3xl font-bold text-center text-gray-800 mb-10">{{ 'manage_users_heading'|trans }}</h1>

        <div class="bg-gray-100 p-4 rounded-lg flex space-x-4">
            <a href="{{ path('app_register') }}" class="px-4 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600">
                {{ 'add_user_button'|trans }}
            </a>
            <a href="{{ path('admin_import_users') }}" class="px-4 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600">
                {{ 'import_users_button'|trans }}
            </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {% for user in users %}
                <div class="bg-white shadow-md rounded-lg overflow-hidden flex flex-col h-full">
                    <!-- User Information -->
                    <div class="p-6 flex flex-col justify-between h-full">
                        <div class="flex items-center mb-4">
                            <img
                                src="{{ user.profilePicture ? asset(user.profilePicture) : asset('assets/images/avatars/default-avatar.png') }}"
                                alt="{{ user.firstName }} {{ user.lastName }}"
                                class="w-16 h-16 rounded-full border border-gray-300 shadow-md mr-4"
                            >
                            <div>
                                <h2 class="text-lg font-bold text-gray-800">{{ user.firstName }} {{ user.lastName }}</h2>
                                <p class="text-sm text-gray-500">{{ user.email }}</p>
                            </div>
                        </div>

                        <!-- User Roles -->
                        <p class="text-sm font-medium text-gray-600 mb-4">{{ 'roles'|trans }}: {{ user.roles | join(', ') }}</p>

                        <!-- Actions -->
                        <a href="{{ path('app_profile_view', {'id': user.id}) }}"
                           class="inline-block px-4 py-2 bg-blue-600 text-white text-sm font-semibold rounded-lg hover:bg-blue-700 transition-all">
                            {{ 'view_profile_button'|trans }}
                        </a>
                    </div>
                </div>
            {% endfor %}
        </div>
        <!-- Pagination Section -->
        <div class="flex justify-center mt-8">
            {{ knp_pagination_render(users) }}
        </div>
    </div>
</section>
{% endblock %}
