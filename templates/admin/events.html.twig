{% extends 'base.html.twig' %}
{% block title %}{{ 'admin_events_title'|trans }}{% endblock %}

{% block body %}
    <section class="py-20 mt-8">
        <div class="container mx-auto">
            <!-- Back to Dashboard Button -->
            <div class="mb-6">
                <a href="{{ path('admin_dashboard') }}"
                   class="inline-flex items-center px-4 py-2 bg-gray-200 text-gray-800 text-sm font-semibold rounded-lg hover:bg-gray-300 transition-all">
                    <i class="uil uil-arrow-left mr-2"></i> {{ 'back_to_dashboard'|trans }}
                </a>
            </div>

            <h1 class="text-3xl font-bold text-center text-gray-800 mb-10">{{ 'manage_events_heading'|trans }}</h1>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                {% for event in events %}
                    <div class="bg-white shadow-md rounded-lg overflow-hidden flex flex-col h-full">
                        <!-- User Information -->
                        <div class="p-6 flex flex-col justify-between h-full">
                            <div class="p-4 flex flex-col justify-between h-full">
                                <p>{{ event.state.label }}</p>
                                <div>
                                    <h2 class="text-lg font-bold text-gray-800">{{ event.name }}</h2>
                                    <p class="text-sm font-medium text-slate-500 mb-4">
                                        {{ event.description | default('no_description'|trans) }}
                                    </p>
                                    <span class="inline-flex items-center bg-primary/20 text-primary text-xs/none font-semibold capitalize rounded mb-4 border-s-2 border-primary px-2 py-1.5">
                                        {{ 'participants'|trans }}: {{ event.participants | length }} / {{ event.maxRegistrations }}
                                    </span>
                                </div>
                                <div class="flex items-center mt-auto">
                                    <img
                                            src="{{ event.organizer.profilePicture ? asset(event.organizer.profilePicture) : asset('assets/images/avatars/default-avatar.png') }}"
                                            class="w-10 h-10 rounded-full"
                                            alt="{{ 'organizer'|trans }}">
                                    <h5 class="text-base font-semibold text-slate-800 ps-4">
                                        {{ event.organizer.username | default('unknown_organizer'|trans) }}
                                    </h5>
                                </div>
                            </div>

                            <!-- Actions -->
                            <a href="{{ path('app_event_show', {'id': event.id}) }}"
                               class="inline-block px-4 py-2 bg-blue-600 text-white text-sm font-semibold rounded-lg hover:bg-blue-700 transition-all">
                                {{ 'view_event'|trans }}
                            </a>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>
{% endblock %}
