{% extends 'base.html.twig' %}

{% block title %}{{ 'calendar_title'|trans }}{% endblock %}

{% block body %}
<section class="py-12 mt-8">
    <div class="container mx-auto max-w-6xl">
        <div class="bg-white shadow-lg rounded-lg p-8">
            <h1 class="text-2xl font-bold text-gray-800 mb-6">{{ 'calendar_heading'|trans }}</h1>
            <div id="calendar"></div>
        </div>
    </div>
</section>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
    document.addEventListener('DOMContentLoaded', function () {

        const calendarEl = document.getElementById('calendar');

        if (calendarEl) {
            try {
                const calendar = new FullCalendar.Calendar(calendarEl, {
                    initialView: 'dayGridMonth',
                    events: '/calendar/events',
                    headerToolbar: {
                        left: 'prev,next today',
                        center: 'title',
                        right: 'dayGridMonth,timeGridWeek,timeGridDay',
                    },
                    locale: '{{ app.request.locale }}',
                    eventClick: function (info) {
                        if (info.event.url) {
                            window.location.href = info.event.url;
                        } else {
                            console.warn('Event does not have a URL:', info.event);
                        }
                    },
                });
                calendar.render();
            } catch (error) {
                console.error('Error initializing FullCalendar:', error);
            }
        } else {
            console.error('Calendar element not found in the DOM.');
        }
    });
    </script>
{% endblock %}
