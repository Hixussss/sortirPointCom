{% extends 'base.html.twig' %}

{% block title %}{{ 'events_title'|trans }}{% endblock %}

{% block body %}
<section id="events" class="py-20 relative bg-cover bg-no-repeat mt-8">
    <div class="container">
        <div class="relative z-30">
            <!-- Header Section -->
            <div class="flex flex-wrap md:flex-nowrap items-center justify-between mb-8">
                <div class="text-left flex-1 mb-4 md:mb-0">
                    <h5 class="capitalize text-lg text-gray-800 font-medium">{{ 'events_heading'|trans }}</h5>
                    <h2 class="text-2xl sm:text-3xl font-bold capitalize text-gray-800">{{ 'latest_events'|trans }}</h2>
                    <p class="text-sm sm:text-base font-medium text-gray-500">{{ 'events_description'|trans }}</p>
                </div>
                {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                    <div class="flex flex-wrap gap-2">
                        <!-- Masquer sur petits écrans -->
                        {% if not is_mobile() %}
                            <a href="{{ path('app_event_new') }}"
                            class="flex items-center px-3 py-2 bg-blue-600 text-white font-medium rounded-md hover:bg-blue-700 transition-all text-sm">
                                <i class="uil uil-plus mr-2"></i> {{ 'create_event_button'|trans }}
                            </a>
                        {% endif %}
                        <!-- Toujours visible -->
                        <a href="{{ path('app_event_user_list') }}"
                        class="flex items-center px-3 py-2 bg-blue-600 text-white font-medium rounded-md hover:bg-blue-700 transition-all text-sm">
                            <i class="uil uil-calendar-alt mr-2"></i> {{ 'my_events_button'|trans }}
                        </a>
                        <a href="{{ path('app_event_user_calendar') }}"
                        class="flex items-center px-3 py-2 bg-blue-600 text-white font-medium rounded-md hover:bg-blue-700 transition-all text-sm">
                            <i class="uil uil-calendar-alt mr-2"></i> {{ 'calendar_button'|trans }}
                        </a>
                    </div>
                {% endif %}
            </div>

            <!-- Filters Section -->
            <form method="get" class="bg-white shadow-md rounded-lg p-4 mb-8">
                <div class="grid lg:grid-cols-4 gap-4">
                    <!-- Search Filter -->
                    <div>
                        <input type="text" name="search" placeholder="{{ 'filters.search_placeholder'|trans }}" value="{{ app.request.get('search') }}"
                            class="w-full border border-gray-300 rounded-md px-4 py-2 text-gray-700 focus:ring-2 focus:ring-blue-500">
                    </div>
                    
                    <!-- City Filter -->
                    <div>
                        <input type="text" name="city" placeholder="{{ 'filters.city_placeholder'|trans }}" value="{{ app.request.get('city') }}"
                            class="w-full border border-gray-300 rounded-md px-4 py-2 text-gray-700 focus:ring-2 focus:ring-blue-500">
                    </div>
                    
                    <!-- Postal Code Filter -->
                    <div>
                        <input type="text" name="postalCode" placeholder="{{ 'filters.postal_code_placeholder'|trans }}" value="{{ app.request.get('postalCode') }}"
                            class="w-full border border-gray-300 rounded-md px-4 py-2 text-gray-700 focus:ring-2 focus:ring-blue-500">
                    </div>

                    <!-- Organizer Filter -->
                    <div>
                        <input type="text" name="organizer" placeholder="{{ 'filters.organizer_placeholder'|trans }}" value="{{ app.request.get('organizer') }}"
                            class="w-full border border-gray-300 rounded-md px-4 py-2 text-gray-700 focus:ring-2 focus:ring-blue-500">
                    </div>
                </div>
                
                <div class="grid lg:grid-cols-4 gap-4 mt-4">
                    <!-- Min Participants Filter -->
                    <div>
                        <input type="number" name="minParticipants" placeholder="{{ 'filters.min_participants_placeholder'|trans }}" value="{{ app.request.get('minParticipants') }}"
                            class="w-full border border-gray-300 rounded-md px-4 py-2 text-gray-700 focus:ring-2 focus:ring-blue-500">
                    </div>

                    <!-- Max Participants Filter -->
                    <div>
                        <input type="number" name="maxParticipants" placeholder="{{ 'filters.max_participants_placeholder'|trans }}" value="{{ app.request.get('maxParticipants') }}"
                            class="w-full border border-gray-300 rounded-md px-4 py-2 text-gray-700 focus:ring-2 focus:ring-blue-500">
                    </div>

                    <!-- Duration Filter -->
                    <div>
                        <input type="number" name="duration" placeholder="{{ 'filters.duration_placeholder'|trans }}" value="{{ app.request.get('duration') }}"
                            class="w-full border border-gray-300 rounded-md px-4 py-2 text-gray-700 focus:ring-2 focus:ring-blue-500">
                    </div>
                    
                    <!-- State Filter -->
                    <div>
                        <select name="state" class="w-full border border-gray-300 rounded-md px-4 py-2 text-gray-700 focus:ring-2 focus:ring-blue-500">
                            <option value="">{{ 'filters.state_placeholder'|trans }}</option>
                            {% for state in states %}
                                <option value="{{ state.id }}" {{ app.request.get('state') == state.id ? 'selected' : '' }}>
                                    {{ state.label|trans }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                </div>

                <div class="flex justify-between mt-4">
                    <button type="submit" class="bg-blue-600 text-white font-bold rounded-md px-4 py-2 hover:bg-blue-700 transition-all">
                        {{ 'filters.apply_filters'|trans }}
                    </button>
                    <a href="{{ path('app_event_list') }}" class="bg-gray-300 text-gray-800 font-bold rounded-md px-4 py-2 hover:bg-gray-400 transition-all">
                        {{ 'filters.reset_filters'|trans }}
                    </a>
                </div>
            </form>




            <!-- Events Section -->
            <div class="grid lg:grid-cols-2 grid-cols-1 gap-6">
                {% for event in events %}
                    <div class="bg-white border border-gray-200 rounded-lg overflow-hidden flex flex-col h-full">
                        <div class="grid sm:grid-cols-2 grid-cols-1">
                            <!-- Map Section -->
                            <div class="relative p-2 h-64">
                                {% if event.staticMapUrl %}
                                    <img src="{{ event.staticMapUrl }}" alt="Static Map" class="w-full h-full rounded-md object-cover">
                                {% else %}
                                    <div class="w-full h-full flex items-center justify-center text-gray-500 bg-gray-200 rounded-md">
                                        {{ 'event_card.no_map'|trans }}
                                    </div>
                                {% endif %}
                            </div>
                            <!-- Info Section -->
                            <div class="p-4 flex flex-col justify-between h-full">
                            <span class="inline-block px-3 py-1 text-xs font-semibold text-white rounded-full capitalize"
                                {% if event.state.label == 'CREATION' %}
                                    style="background-color: #4caf50;" <!-- Green -->
                                {% elseif event.state.label == 'REGISTRATION OPEN' %}
                                    style="background-color: #2196f3;" <!-- Blue -->
                                {% elseif event.state.label == 'REGISTRATION CLOSED' %}
                                    style="background-color: #ff9800;" <!-- Orange -->
                                {% elseif event.state.label == 'ONGOING' %}
                                    style="background-color: #ffeb3b;" <!-- Yellow -->
                                {% elseif event.state.label == 'CANCELED' %}
                                    style="background-color: #f44336;" <!-- Red -->
                                {% elseif event.state.label == 'FINISHED' %}
                                    style="background-color: #9c27b0;" <!-- Purple -->
                                {% elseif event.state.label == 'ARCHIVED' %}
                                    style="background-color: #607d8b;" <!-- Gray -->
                                {% endif %}>
                                {{ event.state.label|trans }}
                            </span>
                                <div>
                                    <a href="{{ path('app_event_show', {'id': event.id}) }}" class="text-lg font-bold mb-2.5">
                                        {{ event.name }}
                                    </a>
                                    <p class="text-sm font-medium text-slate-500 mb-4">
                                        {{ event.description | default('no_description'|trans) }}
                                    </p>
                                    <p class="text-sm text-gray-600 font-medium mb-4">
                                        <strong>{{ 'event_card.location'|trans }}:</strong> {{ event.location.name | default('event_card.no_location'|trans) }}
                                    </p>
                                    <span class="inline-flex items-center bg-primary/20 text-primary text-xs/none font-semibold capitalize rounded mb-4 border-s-2 border-primary px-2 py-1.5">
                                        {{ 'event_card.participants'|trans }}: {{ event.participants | length }} / {{ event.maxRegistrations }}
                                    </span>
                                </div>
                                <div class="flex items-center mt-auto">
                                    <img 
                                        src="{{ event.organizer.profilePicture ? asset(event.organizer.profilePicture) : asset('assets/images/avatars/default-avatar.png') }}" 
                                        class="w-10 h-10 rounded-full" 
                                        alt="Organizer">
                                    <h5 class="text-base font-semibold text-slate-800 ps-4">
                                        {{ event.organizer.username | default('unknown_organizer'|trans) }}
                                    </h5>
                                </div>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <p class="text-center text-gray-600 col-span-full">{{ 'no_events_message'|trans }}</p>
                {% endfor %}
            </div>
            <!-- Pagination Section -->
            <div class="flex justify-center mt-8">
                {{ knp_pagination_render(events) }}
            </div>
        </div>
    </div>
</section>
{% endblock %}
